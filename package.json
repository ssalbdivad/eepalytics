{
	"name": "eepalytics",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=25"
	},
	"scripts": {
		"dev": "concurrently -n web,daemon -c cyan,magenta \"pnpm dev:web\" \"pnpm dev:daemon\"",
		"dev:web": "vite",
		"dev:daemon": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings=ExperimentalWarning --watch-path=src/daemon --watch-path=src/lcu --watch-path=src/server --watch-path=src/shared --watch-path=src/analysis --watch-path=src/review src/daemon/main.ts",
		"daemon": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings=ExperimentalWarning src/daemon/main.ts",
		"build": "vite build",
		"start": "NODE_ENV=production pnpm daemon",
		"doctor": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings=ExperimentalWarning scripts/doctor.ts",
		"seed": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings=ExperimentalWarning scripts/dev-seed.ts",
		"rofl": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/rofl/decode.ts",
		"service:install": "bash scripts/install-service.sh",
		"service:logs": "journalctl --user -u eepalytics -f",
		"typecheck": "tsc --noEmit",
		"test": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings=ExperimentalWarning --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
		"app": "pnpm build && electron .",
		"app:dev": "concurrently -n web,app -c cyan,green \"pnpm dev:web\" \"CSK_DEV=1 electron .\"",
		"electron": "electron .",
		"icon": "electron scripts/make-icon.mjs",
		"shoot": "electron scripts/shoot.mjs",
		"bench:events": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/bench-events.ts",
		"bench:stream": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings=ExperimentalWarning scripts/bench-stream.ts",
		"rescore": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/rescore-runs.ts",
		"diagnose:unbacked": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/diagnose-unbacked.ts",
		"pack": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings=ExperimentalWarning scripts/game-pack.ts",
		"backfill": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings=ExperimentalWarning scripts/backfill-reviews.ts",
		"smoke:live": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings=ExperimentalWarning scripts/smoke-live.ts",
		"what-wins": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/what-wins.ts",
		"read:frame-ablation": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/read-frame-ablation.ts"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^4.0.49",
		"@ai-sdk/google": "^4.0.64",
		"@ai-sdk/openai": "^4.0.59",
		"@anthropic-ai/claude-agent-sdk": "^0.3.258",
		"@hono/node-server": "^2.1.1",
		"ai": "^7.0.93",
		"arktype": "^2.2.3",
		"hono": "^4.13.5",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@types/node": "^26.4.1",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6.1.1",
		"concurrently": "^9",
		"electron": "^44.1.1",
		"typescript": "^5.9",
		"vite": "^8.2.2"
	},
	"main": "electron/main.mjs"
}
