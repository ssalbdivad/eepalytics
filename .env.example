# coachskaffur — copy to `.env` and edit. Every value here is optional; the defaults in
# src/shared/constants.ts are already correct for this machine.
#
#   cp .env.example .env
#
# `.env` is gitignored. Nothing in here is a secret except ANTHROPIC_API_KEY.

# ---------------------------------------------------------------- storage

# Where the database, gzipped match blobs, downloaded replays and captured media live.
# KEEP THIS ON ext4. SQLite on the /mnt/c 9p mount measured ~26x slower.
CSK_DATA_DIR=/home/ssalb/coachskaffur/data

# ---------------------------------------------------------------- server

# Hono listens here; the vite dev server on :7701 proxies /api and /media to it.
CSK_PORT=7700
# CSK_HOST=127.0.0.1

# ---------------------------------------------------------------- coaching

# Which model writes the reviews. Overrides the `model` setting on startup.
# This is also editable in the UI under Settings.
CSK_MODEL=claude-sonnet-5

# OPTIONAL. Leave this UNSET to use your existing `claude` CLI login, which is the intended
# default and costs nothing extra. Set it only if you want reviews billed against an API key
# instead — e.g. on a machine where Claude Code is not installed.
# ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------- League

# Only needed if League is not in the default location. The lockfile is read from
# "$CSK_LEAGUE_DIR/lockfile" and carries the client's rotating port and password.
# CSK_LEAGUE_DIR=/mnt/c/Games/Riot Games/League of Legends

# ---------------------------------------------------------------- account

# Who to coach. Games are matched on PUUID; summonerName is "" everywhere now and
# accountId is 0, so the PUUID is the only reliable key.
# CSK_PUUID=188dee22-18d6-5752-ba7f-b69cf3d2506e
# CSK_RIOT_ID=Gooskaffur#NA1
